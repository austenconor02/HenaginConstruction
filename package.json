{
  "name": "henagin-home-improvement",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/lib/*.test.ts",
    "check:smoke": "node scripts/smoke.mjs",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:logo": "node scripts/prepare-logo.mjs",
    "assets:strips": "node scripts/prepare-paint-strips.mjs",
    "assets:gallery": "node scripts/prepare-gallery.mjs",
    "build:backend": "npm --prefix functions run build",
    "test:backend": "npm --prefix functions test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "firebase": "12.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "sharp": "^0.34.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
